# ==============================================================================
# MediConnect Environment Variables Template (.env.example)
# Copy this file to .env.local on your AWS server or configure in your deployment platform.
# ==============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://mediconnect.fit
VERCEL=1

# ─── AWS RDS PostgreSQL Database ─────────────────────────────────────────────
DB_HOST=mediconnect-stag-db.c7iqgcom8eml.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=mediconnect
DB_SSL=true

# ─── AWS S3 Storage & CloudFront CDN ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=mediconnect-prod-storage
AWS_REGION=ap-south-1
NEXT_PUBLIC_CLOUDFRONT_URL=https://d11fi0esezlwk0.cloudfront.net

# ─── AI Engine (MediConnect AI - GPT-6 Luna) ─────────────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_api_key
AI_LUNA_ENABLED=true
AI_LUNA_MODEL=gpt-6-luna

# ─── WhatsApp & SMS Communication (InsignSMS Multichannel) ───────────────────
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mediconnect_wa_verify_2024
INSIGN_WHATSAPP_TOKEN=170|your_insign_multichannel_token
INSIGN_WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@mediconnect.fit
SMTP_PASSWORD="your_smtp_app_password"
SMTP_FROM=support@mediconnect.fit
CRON_SECRET=your_cron_secret_token

# ─── Firebase Cloud Messaging (Push Notifications) ───────────────────────────
FCM_PROJECT_ID=mediconnect-4e704
FCM_CLIENT_EMAIL=firebase-adminsdk-fbsvc@mediconnect-4e704.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mediconnect-4e704.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mediconnect-4e704
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=914735542884
NEXT_PUBLIC_FIREBASE_APP_ID=1:914735542884:web:2e7afc4e9de87e1d196571
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# ─── Video Consultations (Agora RTC) ─────────────────────────────────────────
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ─── Payment Gateway (Razorpay) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# ─── Third-Party Services ───────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
PDFSHIFT_KEY=your_pdfshift_key
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
